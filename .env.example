# Clés VAPID pour Web Push. Générer avec :  npx web-push generate-vapid-keys
# La clé PUBLIQUE est exposée au client (préfixe PUBLIC_ requis par SvelteKit).
PUBLIC_VAPID_KEY=""

# URL de base des Netlify Functions (le micro-scheduler). En prod : /.netlify/functions
PUBLIC_SCHEDULER_URL="/.netlify/functions"

# --- Côté serveur uniquement (Netlify Functions ; NE PAS préfixer PUBLIC_) ---
# À définir dans les variables d'environnement Netlify, jamais commitées :
#   VAPID_PUBLIC_KEY   (identique à PUBLIC_VAPID_KEY)
#   VAPID_PRIVATE_KEY  (secret)
#   VAPID_SUBJECT      (ex: mailto:ton-email@example.com)
